generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  EMPLOYEE
  USER
  ADMIN
  SUPER_ADMIN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BONUS
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                        String        @id @default(auto()) @map("_id") @db.ObjectId
  name                      String
  phone                     String        @unique
  email                     String?
  passwordHash              String?
  role                      Role          @default(CLIENT)
  permissions               Json?
  isBlocked                 Boolean       @default(false)
  bonusPercentage           Float         @default(0)
  totalBalancePaise         Int           @default(0) // Total wallet points (1 point = 1 INR)
  
  // Deposit & Withdrawal Points Cycle Logic
  activeBonusPaise          Int           @default(0) // Active bonus points from current cycle
  lastDepositAmountPaise    Int           @default(0) // Principal amount of the latest deposit in cycle
  cycleWithdrawnPaise       Int           @default(0) // Points withdrawn so far in current cycle
  isBonusDeductedInCycle    Boolean       @default(false) // Whether bonus points have been cut in this cycle

  // Employee Location Tracking
  lastLatitude              Float?
  lastLongitude             Float?
  lastLocationAccuracy      Float?
  lastLocationAddress       String?
  lastLocationUpdatedAt     DateTime?

  // Creator / Onboarding tracking (Which employee/admin added this client)
  createdById               String?
  createdByName             String?
  createdByRole             String?

  upiId                     String?
  bankAccountNumber         String?
  bankIfsc                  String?
  bankName                  String?
  bankAccountHolderName     String?
  avatarUrl                 String?
  // Soft delete & archive/backup tracking (hidden from live app, restorable via backup)
  isArchived                Boolean       @default(false)
  archivedAt                DateTime?
  archivedById              String?
  backupBatchId             String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  transactions              Transaction[]
  locations                 EmployeeLocation[]
}

model EmployeeLocation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @db.ObjectId
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  accuracy    Float?
  address     String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

model Transaction {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  userId             String            @db.ObjectId
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               TransactionType
  status             TransactionStatus @default(PENDING)
  amountPaise        Int               // Points (deposited or requested to withdraw)
  bonusPaise         Int               @default(0) // Bonus points added (deposit) or deducted (withdrawal)
  cashPaidPaise      Int               @default(0) // Actual cash (INR) paid out on withdrawal
  withdrawablePaise  Int               @default(0)
  utr                String?
  imageHash          String?
  imageUrl           String?
  paymentApp         String?
  rawOcrData         Json?
  rejectionReason    String?
  processedByAdminId String?
  processedByName    String?
  // Soft delete & archive/backup tracking
  isArchived         Boolean           @default(false)
  archivedAt         DateTime?
  archivedById       String?
  backupBatchId      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId])
}

model DailyBonus {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  date                String   @unique // YYYY-MM-DD
  percentage          Float    @default(0.0)
  isActive            Boolean  @default(true)
  createdById         String?
  createdByName       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
